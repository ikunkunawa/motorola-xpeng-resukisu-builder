@@ -113,3 +113,7 @@ CONFIG_PSTORE_RAM=n
 
 CONFIG_CNSS_QCA6490=y
 CONFIG_QCA_CLD_WLAN_DYNAMIC_SINGLE_CHIP_NAME="qca6490"
